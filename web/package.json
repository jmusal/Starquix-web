{
  "name": "starquix-web",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Starquix in the browser: a local Node server that runs each project's Astro dev server and serves the editor",
  "type": "module",
  "bin": {
    "starquix-web": "./src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "SQ_WEB_DEV_EDITOR=http://127.0.0.1:3061 node src/server.mjs",
    "build": "npm --prefix ../app run build && npm --prefix ../desktop run deps && npm --prefix ../desktop run mcp",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "isomorphic-git": "^1.43.1",
    "ws": "^8.18.3"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "vitest": "4.0.16",
    "@playwright/test": "^1.58.0"
  },
  "engines": {
    "node": ">=22"
  }
}
